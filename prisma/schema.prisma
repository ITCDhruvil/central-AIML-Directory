// Prisma schema — Project data model (Phase 1)
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  // ProjectType: PROJECT | POC | EXPERIMENT | TOOL | OTHER
  type   String
  // ProjectStatus: ACTIVE | COMPLETED | ON_HOLD | ARCHIVED
  status String
  // ProjectStage: IDEA | POC | DEVELOPMENT | TESTING | PRODUCTION | ARCHIVED
  // Nullable — existing projects stay unset until edited; new projects default to IDEA in app code.
  stage  String?
  // Free-text project owner (not GitHub repo owner; no auth/user system).
  owner  String?

  githubUrl     String?
  githubOwner   String?
  githubRepo    String?
  defaultBranch String?

  // JSON-encoded string arrays (SQLite has no native scalar-list/enum support)
  technologies   String @default("[]")
  tags           String @default("[]")
  deploymentUrls String @default("[]")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSyncedAt DateTime?

  documentation Documentation[]
  activities    ProjectActivity[]
  environments  ProjectEnvironment[]
  note          ProjectNote?

  @@index([status])
  @@index([type])
}

model Idea {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  // IdeaStatus: ACTIVE | ON_HOLD | PROMOTED | ARCHIVED
  status String  @default("ACTIVE")
  // Free-text idea owner (no auth/user system — same convention as Project.owner).
  owner  String?

  // JSON-encoded string arrays (SQLite has no native scalar-list/enum support)
  technologies String @default("[]")
  tags         String @default("[]")

  // Set once this idea is promoted into a real Project — see promoteIdeaToProject().
  // Plain string, not a formal relation, matching the loose-coupling style used
  // elsewhere in this schema (e.g. Project.githubOwner/githubRepo).
  promotedProjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Reusable owner names for project/idea forms. Free-text on Project/Idea; an admin can
// link a name to a User so that user's "own" scope matches items owned by this name.
model Owner {
  id        String   @id @default(cuid())
  name      String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Auth, roles and permissions
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  // Role: ADMIN | MANAGER | MEMBER | VIEWER
  role               String    @default("MEMBER")
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  // Bumped to invalidate every existing session of this user.
  sessionVersion     Int       @default(0)
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime?

  owners         Owner[]
  permissions    UserPermission[]
  quota          AiQuota?
  notifications  Notification[]
  resetRequests  PasswordResetRequest[] @relation("ResetRequestUser")
  resolvedResets PasswordResetRequest[] @relation("ResetRequestResolver")
  aiUsage        AiUsageLog[]
  auditEntries   AuditLog[]
  sharesReceived ItemShare[]            @relation("ShareRecipient")
  sharesGranted  ItemShare[]            @relation("ShareGrantor")
  passwordHistory PasswordHistory[]
  avatar          UserAvatar?
  githubConnection GithubConnection?
}

// A person's profile picture. Kept in its own table so the image bytes are never loaded with ordinary user queries;
// only the avatar endpoint reads `data`. updatedAt doubles as the cache-busting version in the picture's URL.
model UserAvatar {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String
  updatedAt   DateTime @updatedAt
}

// A person's own GitHub OAuth grant, so repository imports run with their access instead of one shared token.
// accessToken is AES-GCM encrypted (see lib/github/tokenCrypto.ts); never stored or logged in plain text.
model GithubConnection {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String
  login       String
  scope       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Hashes of a user's previous passwords, so they can't go back to a recent one.
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Admin-edited role defaults. Missing rows fall back to built-in defaults in code.
model RolePermission {
  id       String @id @default(cuid())
  role     String
  resource String
  action   String
  // NONE | OWN | ALL
  scope    String

  @@unique([role, resource, action])
}

// Per-user override of the role default for one resource/action.
model UserPermission {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource String
  action   String
  scope    String

  @@unique([userId, resource, action])
}

model PasswordResetRequest {
  id           String    @id @default(cuid())
  email        String
  userId       String?
  user         User?     @relation("ResetRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  // PENDING | RESOLVED | REJECTED
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ResetRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  // true when the person asked while signed in (Settings → Security). Only those can be auto-issued after the wait.
  viaSession   Boolean   @default(false)

  @@index([status, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // e.g. PASSWORD_RESET_REQUESTED
  type      String
  // JSON-encoded string
  payload   String    @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// Global key/value admin settings (JSON-encoded values), e.g. "ai.enabled".
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Per-user AI limits; null fields inherit the AppSetting defaults. null = unlimited.
model AiQuota {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRequests Int?
  monthlyTokens Int?
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // OK | BLOCKED_QUOTA | BLOCKED_PERMISSION | ERROR
  status       String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  // JSON-encoded string
  meta       String   @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// Grants one user access to a specific project/idea beyond their owner scope.
model ItemShare {
  id          String   @id @default(cuid())
  // PROJECT | IDEA
  entityType  String
  entityId    String
  userId      String
  user        User     @relation("ShareRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // VIEW | EDIT
  access      String   @default("VIEW")
  grantedById String?
  grantedBy   User?    @relation("ShareGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([entityType, entityId, userId])
  @@index([userId])
}

model ProjectActivity {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // User who triggered the event; null for events before auth existed or system events.
  actorId   String?

  // ProjectActivityType: PROJECT_CREATED | PROJECT_UPDATED | GITHUB_SYNCED | DOCUMENTATION_UPDATED | DEPLOYMENT_UPDATED
  type  String
  title String

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Documentation {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title    String
  // DocumentCategory: README | SETUP | ARCHITECTURE | PRD | PLAN | AI_RULES | DESIGN | OTHER
  category String
  filePath String
  content  String
  source   String @default("github")

  // sha256 of the pristine (pre-user-edit) generated content — only set for
  // source="generated" docs. Used by sync to detect whether the user has
  // manually edited a generated setup guide since it was last (re)generated.
  generatedFromContentHash String?

  // Present only for source="upload": the original file (PDF, image, ...). `content` stays empty for those.
  file DocumentFile?

  // RAG index for the per-project Ask AI: searchable chunks and the per-document index metadata.
  chunks     DocumentChunk[]
  indexState DocumentIndex?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, filePath])
  @@index([projectId])
}

// One searchable chunk of a document, with its embedding vector (JSON-encoded float array, so no pgvector dependency).
model DocumentChunk {
  id         String        @id @default(cuid())
  projectId  String
  documentId String
  document   Documentation @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  embedding  String
  tokens     Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([projectId])
  @@index([documentId])
}

// Per-document index metadata, so a document is only re-embedded when its text or the embedding model changes.
model DocumentIndex {
  documentId  String        @id
  document    Documentation @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectId   String
  // sha256 of the extracted text plus the embedding model name.
  contentHash String
  model       String
  chunkCount  Int           @default(0)
  // INDEXED | EMPTY | FAILED
  status      String
  error       String?
  indexedAt   DateTime      @default(now()) @updatedAt

  @@index([projectId])
}

// The bytes of an uploaded document. Kept in its own table, like UserAvatar, so listing documents never loads them.
model DocumentFile {
  documentId  String        @id
  document    Documentation @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime      @default(now())
}

// An image, video or audio file added to a note or document from the editor. Served to signed-in people only, at
// /api/media/<id>; the note itself just holds that link.
model MediaFile {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Directory-wide ("catalog") or per-project AI suggestions. Regenerating updates
// matching cards in place (see insightFingerprint) and may add new ones.
model Insight {
  id          String @id @default(cuid())
  // "catalog" for the Insights page, or a Project.id for Suggest Improvements.
  scope       String
  fingerprint String

  // Suggestion type: new_idea | improvement
  type               String
  title              String
  reasoning          String
  suggestedTool      String?
  relatedProjectName String?
  // JSON-encoded string[]
  sourceUrls         String  @default("[]")
  savedAsIdea        Boolean @default(false)
  // Last merge result for this card: added | updated | unchanged | null (not in last run)
  lastChange         String?

  firstGeneratedAt DateTime @default(now())
  lastGeneratedAt  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([scope, fingerprint])
  @@index([scope, lastGeneratedAt])
}

model InsightGeneration {
  id             String   @id @default(cuid())
  scope          String
  generatedAt    DateTime @default(now())
  addedCount     Int
  updatedCount   Int
  unchangedCount Int
  // JSON-encoded string[]
  addedTitles    String   @default("[]")
  updatedTitles  String   @default("[]")

  @@index([scope, generatedAt])
}

// One deployment environment of a project (DEV, QA, UAT, PROD or a custom one). Generic per project; managed from the UI.
model ProjectEnvironment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String
  // Marks a production-like environment. The server refuses to store test credentials for these.
  isProduction Boolean @default(false)
  // EnvironmentStatus: LIVE | DOWN | NOT_DEPLOYED | PLANNED | UNKNOWN
  status       String  @default("UNKNOWN")
  appUrl       String?
  apiUrl       String?
  healthUrl    String?
  hosting      String?
  databaseSet  String?
  version      String?
  lastDeployedAt DateTime?
  notes        String?
  position     Int     @default(0)
  // Set by the optional health-check ping.
  lastCheckedAt DateTime?

  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  links       EnvironmentLink[]
  credentials EnvironmentCredential[]

  @@unique([projectId, name])
  @@index([projectId, position])
}

model EnvironmentLink {
  id            String             @id @default(cuid())
  environmentId String
  environment   ProjectEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  label String
  url   String
  // App | API | Health | Docs | Azure Portal | ... (free text)
  group String?
  position Int @default(0)

  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@index([environmentId, position])
}

// A test account for one environment. passwordEnc is AES-256-GCM encrypted (see lib/environments/credentialCrypto.ts);
// it is never returned by list endpoints, only by the audited reveal endpoint.
model EnvironmentCredential {
  id            String             @id @default(cuid())
  environmentId String
  environment   ProjectEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  purpose     String
  // A Lucide icon name (PascalCase, e.g. "ShieldCheck") shown with the role; null falls back to a default for the role.
  icon        String?
  username    String
  passwordEnc String?
  notes       String?

  passwordUpdatedByName String?
  passwordUpdatedAt     DateTime?
  updatedByName         String?
  updatedAt             DateTime  @updatedAt
  createdAt             DateTime  @default(now())

  @@index([environmentId])
}

// A single free-text notepad per project (meeting notes, decisions, to-dos). Rich text stored as Markdown.
model ProjectNote {
  projectId     String   @id
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content       String   @default("")
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A dated note entry — a day in someone's journal, or a day in a project's shared log. `day` is "YYYY-MM-DD" text to
// avoid timezone drift. scope is loose (no FK), like Insight.scope: scopeType USER with a user id, or PROJECT with a
// project id. One entry per (scope, day).
model DayNote {
  id         String   @id @default(cuid())
  // USER | PROJECT
  scopeType  String
  scopeId    String
  day        String
  content    String   @default("")
  authorName String?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scopeType, scopeId, day])
  @@index([scopeType, scopeId, day])
}

// Extra pages for a day or a week of notes, so one day can hold several short notes. `key` is the day ("YYYY-MM-DD")
// or the week ("week:YYYY-MM-DD", the Monday). Same loose scope as DayNote.
model DayNotePage {
  id         String   @id @default(cuid())
  scopeType  String
  scopeId    String
  key        String
  title      String   @default("")
  content    String   @default("")
  position   Int      @default(0)
  pinned     Boolean  @default(false)
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scopeType, scopeId, key])
}

// Earlier copies of a day note or page, kept so a bad edit or AI rewrite can be undone. `noteKey` is the day, or
// "page:<id>" for a page.
model NoteVersion {
  id         String   @id @default(cuid())
  scopeType  String
  scopeId    String
  noteKey    String
  content    String
  authorName String?
  createdAt  DateTime @default(now())

  @@index([scopeType, scopeId, noteKey, createdAt])
}

// A person's own saved note templates (the built-in ones live in the editor).
model NoteTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}
