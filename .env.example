# Copy this file to .env and adjust as needed. Never commit .env.
# PostgreSQL connection string (Prisma Postgres, Neon, or any Postgres host).
# Local SQLite is not used in production — Vercel cannot persist a SQLite file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional. Used server-side only for GitHub repository import.
# Without it, only public repositories can be imported (unauthenticated
# GitHub API rate limits apply). With it, private repos the token can
# access also work. Never expose this to the browser.
GITHUB_TOKEN=

# Optional. Enables the Project Knowledge Assistant (Ask Project) on the
# project detail page. Server-side only — never exposed to the browser.
# Without it, the assistant reports itself as not configured. OpenAI-
# compatible key; the hyphenated name matches the platform team's convention.
CENTRAL-AI-PLATFORM_API-KEY=
# Vercel-friendly alias (letters, numbers, underscores only). Either name works.
CENTRAL_AI_PLATFORM_API_KEY=
# Optional. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=

# Optional. Enables real web search for the Insights feature (the AI can look
# up current tools/trends before suggesting anything). Get a free key at
# https://langsearch.com. Without it, insights still generate but from the
# model's training knowledge only — no live grounding, no "trending" claims
# backed by an actual search. Server-side only.
LANGSEARCH_API_KEY=
